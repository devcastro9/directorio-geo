# Django
DEBUG=False
SECRET_KEY=secret_key
ALLOWED_HOSTS=midominio.com,www.midominio.com

# Base de datos (usados por el servicio "db")
POSTGRES_DB=directorio
POSTGRES_USER=directorio
POSTGRES_PASSWORD=passworddb

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin12345

# URL que lee django-environ (el host es el nombre del servicio: "db")
DATABASE_URL=postgis://directorio:passworddb@db:5432/directorio