# Copiar a .env solo si no existe. Sustituir los valores vacios.
POSTGRES_DB=directorio
POSTGRES_USER=directorio
POSTGRES_PASSWORD=

# Obligatoria solo para iniciar pgAdmin con --profile tools.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# Puertos del host; los servicios se comunican por sus puertos internos.
BACKEND_PORT=8000
FRONTEND_PORT=3000
PGADMIN_PORT=5050
# Solo docker-compose.dev.yml publica PostgreSQL en loopback.
POSTGRES_PORT=5432
